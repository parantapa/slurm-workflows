{#- name: "worker_sbatch_script" -#}

# The worker script publishes when this pilot job starts and exits.
# It runs in a bash of its own, so its setup script leaves this shell as it was.
# A failure to publish does not end the job.
report_pilot_job() {
    /bin/bash '{{ worker_script_path }}' --pilot-job-event "$1" || true
}
# This trap turns the SIGTERM that Slurm sends into `exit 143` (128 + 15).
# See the developer notes, Slurm interaction.
trap 'exit 143' TERM
trap 'report_pilot_job exit' EXIT
report_pilot_job start

{% if is_batch_worker %}
echo "Running batch worker."

. '{{ worker_script_path }}'
{% else %}
# A job of one Slurm task writes to the batch job's own output file,
# so a file per Slurm task only duplicates it.
# The shell decides, since Python cannot know the count when it renders the script.
# `SLURM_NTASKS` alone settles the count
# whenever the submission gave `--ntasks` or any `--ntasks-per-*` option.
# Slurm leaves it unset only when the submission gave no count,
# and then `SLURM_JOB_NUM_NODES` stands in, at one Slurm task per node.
# The count is per job, not per node:
# `--nodes=4 --ntasks-per-node=1` is four Slurm tasks, with a file for each.
# `:-` keeps an unset variable from becoming an error if `-u` is ever set.
num_slurm_tasks="${SLURM_NTASKS:-${SLURM_JOB_NUM_NODES:-}}"
# The batch output file must say why the shell took the branch below.
echo "Num Slurm tasks: ${num_slurm_tasks}"
if [[ "${num_slurm_tasks}" = "1" ]] ; then
    # The batch output file is the only record of a job
    # that dies before the worker script gets as far as its own log.
    # For this reason, `set -x` comes before `srun` in both branches.
    set -x
    srun /bin/bash '{{ worker_script_path }}'
else
    echo "Redirecting output."

    set -x
    # One file for each Slurm task,
    # so the Slurm tasks do not interleave into the one batch output file.
    srun --output '{{ work_dir }}/{{ name }}-%j-%t.out' /bin/bash '{{ worker_script_path }}'
fi
{% endif %}

{#- name: "worker_script" -#}

#!/bin/bash

. '/etc/profile'

{{ setup_script }}

# Strict mode starts only after the setup script.
# A setup script often runs `module load` and `conda activate`,
# which do not work well under `set -Eeuo pipefail`.
set -Eeuo pipefail
set -x

# A worker that exits with {{ restart_exit_code }} asked for a restart.
# See the developer notes, Restarting workers.
# `|| status=$?` keeps `set -e` from ending the script on that status.
# The batch script passes `--pilot-job-event` through here.
while true; do
    status=0
    {{ worker_exe }} \
        --group '{{ group }}' \
        --name '{{ name }}' \
        --actor-class-name '{{ actor_class_name }}' \
        --server-address '{{ server_address }}' \
        --work-dir '{{ work_dir }}' \
        --python-paths-json '{{ python_paths_json }}' \
        "$@" || status=$?
    if [[ "${status}" -ne {{ restart_exit_code }} ]] ; then
        break
    fi
    echo "Worker asked for a restart; starting it again."
done
exit "${status}"
